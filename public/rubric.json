{
  "version": "2.0",
  "fields": {
    "context": {
      "label": "Контекст и потребность",
      "weight": 20,
      "checks": [
        {
          "label": "Описан процесс или участник",
          "pattern": "менеджер|оператор|клиент|заявк|обращен|процесс|заказ|студент|родител|сотрудник|преподавател"
        },
        {
          "label": "Названа проблема или её последствие",
          "pattern": "вручную|теря|ошиб|трат|долго|час|минут|задерж|неудоб|проблем|сложн"
        }
      ]
    },
    "data": {
      "label": "Данные и материалы",
      "weight": 20,
      "checks": [
        {
          "label": "Назван источник или формат",
          "pattern": "csv|excel|таблиц|выгруз|документ|датасет|api|истори|список|запис|форм"
        },
        {
          "label": "Есть объём, пример или условия доступа",
          "pattern": "[0-9]|пример|обезлич|доступн|предостав|открыт|согласован"
        }
      ]
    },
    "expected": {
      "label": "Ожидаемый результат",
      "weight": 15,
      "checks": [
        {
          "label": "Назван передаваемый результат",
          "pattern": "прототип|дашборд|сервис|форм[аыу]|каталог|отч[её]т|модел|классификатор|реестр|бот|модуль"
        },
        {
          "label": "Описана функция результата",
          "pattern": "импорт|фильтр|поиск|подбор|просмотр|сбор|классифиц|распредел|маршрутиз|формирован|автомат|экспорт|анализ|уведомл"
        }
      ]
    },
    "success": {
      "label": "Критерии успеха",
      "weight": 15,
      "checks": [
        {
          "label": "Есть численный порог и метрика",
          "pattern": "[0-9].*(%|процент|час|минут|секунд|заяв|обращен|точност|ошиб|пользовател|кружк)|(%|процент|точност|ошиб|врем).*?[0-9]"
        },
        {
          "label": "Указано правило приёмки",
          "pattern": "не менее|не более|менее чем|как минимум|не хуже|точност|при[её]м|из [0-9]|без руч|эконом|за [0-9]|до [0-9]|[0-9]+%"
        }
      ]
    },
    "constraints": {
      "label": "Ограничения",
      "weight": 10,
      "checks": [
        {
          "label": "Указан срок",
          "pattern": "[0-9].*(дн|ден|недел|месяц|час)|к концу|до [0-9]|срок.*[0-9]"
        },
        {
          "label": "Есть техническое или организационное ограничение",
          "pattern": "без |нельзя|только|не использовать|доступ|синтетич|бюджет|python|веб|персональн"
        }
      ]
    },
    "users": {
      "label": "Пользователи",
      "weight": 10,
      "checks": [
        {
          "label": "Названа группа пользователей",
          "pattern": "менеджер|оператор|родител|студент|преподавател|клиент|сотрудник|руководител|аналитик|пользовател"
        },
        {
          "label": "Есть контекст, сегмент или роль",
          "pattern": "отдел|продаж|лет|контакт|центр|образов|команд|ежеднев|обработ|курс|класс|компани|служб|школ"
        }
      ]
    },
    "business": {
      "label": "Связь с бизнесом",
      "weight": 10,
      "checks": [
        {
          "label": "Назван ответственный или канал связи",
          "pattern": "контакт|руководител|куратор|ответствен|@|почт|telegram|телеграм|менеджер"
        },
        {
          "label": "Есть частота обратной связи",
          "pattern": "еженед|ежеднев|раз в|созвон.*недел|встреч.*недел|по пятниц|[0-9].*раз"
        }
      ]
    }
  }
}